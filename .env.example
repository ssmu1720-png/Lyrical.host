# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# DEPLOYMENT_API_URL: Optional external deployment provider endpoint.
# If unset, LYRICAL uses the integrated local Node/Python Process Manager & Git Runner.
DEPLOYMENT_API_URL=""
DEPLOYMENT_API_KEY=""

# Security secrets for sessions, tokens, and administrator elevation
JWT_SECRET="lyrical-production-jwt-secret-key-2026"
ADMIN_SECRET="lyrical-admin-secret-2026"
DATABASE_URL="file:./data/lyrical-db.json"
